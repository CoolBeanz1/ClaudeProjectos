# Copy this file to .env and fill in your values.
# Used by the systemd services in deploy/ (EnvironmentFile) — plain KEY=VALUE, no quotes needed.

# Model to use. On a Pi 5 (8GB), small models run best:
#   llama3.2:1b   - fastest, least capable
#   qwen2.5:1.5b  - good balance
#   llama3.2:3b   - slower but noticeably smarter, still usable
JARVIS_MODEL=llama3.2:1b

# Set to false to disable the JARVIS persona system prompt
JARVIS_PERSONA=true

# Web server port
PORT=3000

# Where Ollama is running (default is correct if it's on the same device)
OLLAMA_HOST=http://127.0.0.1:11434

# Get this from @BotFather on Telegram (only needed for the telegram bot service)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat ID (send /start to your bot to get it).
# Leave blank while setting up, then set it and restart the service to lock the bot to just you.
TELEGRAM_ALLOWED_CHAT_ID=
